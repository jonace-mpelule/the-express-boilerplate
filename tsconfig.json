{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2017",
      "ESNext.AsyncIterable"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "/src/types"
    ],
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "module": "CommonJS",
    "pretty": true,
    "sourceMap": true,
    "outDir": "./build",
    "allowJs": true,
    "noEmit": false,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@config/*": [
        "./config/*"
      ],
      "@routes/*": [
        "./routes/*"
      ],
      "@helpers/*": [
        "./helpers/*"
      ],
      "@types/*": [
        "./types/*"
      ],
      "@middleware/*": [
        "./middleware/*"
      ],
      "@loaders/*": [
        "./loaders/*"
      ],
      "@services/*": [
        "./services/*"
      ],
      "@utils/*": [
        "./utils/*"
      ],
    }
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}